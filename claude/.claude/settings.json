{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(brew *)",
      "Bash(claude -p *)",
      "Bash(composer dump-autoload *)",
      "Bash(composer install *)",
      "Bash(composer list *)",
      "Bash(composer show *)",
      "Bash(composer update *)",
      "Bash(docker system *)",
      "Bash(du *)",
      "Bash(find *)",
      "Bash(gh api *)",
      "Bash(gh issue view *)",
      "Bash(gh label *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr view *)",
      "Bash(gh repo *)",
      "Bash(git add *)",
      "Bash(git blame *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git cherry-pick *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git log *)",
      "Bash(git pull *)",
      "Bash(git push *)",
      "Bash(git rebase *)",
      "Bash(git worktree *)",
      "Bash(grep *)",
      "Bash(jetpack *)",
      "Bash(ls *)",
      "Bash(npm run lint*)",
      "Bash(npm run lint:js*)",
      "Bash(npm run start*)",
      "Bash(npm run test:js*)",
      "Bash(npm test)",
      "Bash(npx tsc *)",
      "Bash(phpcs *)",
      "Bash(tmux *)",
      "Read",
      "WebFetch(domain:developer.chrome.com)",
      "WebFetch(domain:developer.wordpress.org)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebSearch",
      "mcp__chrome-devtools",
      "mcp__context-a8c"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.docker/config.json)",
      "Read(~/.zsh_history)",
      "Read(~/.bash_history)",
      "Read(~/Library/**)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(svn ci *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/pre-commit-review.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "basename \"$PWD\"",
    "padding": 0
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true
  },
  "teammateMode": "tmux",
  "defaultMode": "bypassPermissions",
  "skills": {
    "allowedSkills": [
      "commit",
      "sup",
      "wrap",
      "review",
      "team",
      "learn"
    ]
  },
  "skipDangerousModePermissionPrompt": true
}
