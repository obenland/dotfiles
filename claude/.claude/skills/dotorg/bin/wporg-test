#!/usr/bin/env bash
#
# wporg-test — run the checks CI runs, locally, against a PR's worktree.
#
# 0. Like CI, test the branch merged into the default branch: a sibling
#    <worktree>-merge checkout is reset to origin/<default branch> and the
#    branch merged in, so the default branch's suites and tests apply even to a
#    branch that predates them. A merge conflict is reported as the finding it
#    is. --no-merge tests the branch as is.
# 1. wordpress.org: phpcs on the branch and the PHPUnit suites whose paths it
#    touches, selected by the wporg-bug-pipeline's bin/wordpress-org-checks.sh
#    exactly as CI does: standalone suites through vendor/bin/phpunit,
#    WordPress suites through their wp-env environment, then a smoke request
#    against each started environment's front page.
#    Every other repo: the checks in its repos.json profile, through that
#    checkout's bin/check.
#
# Someone else's PR runs its code here, so it needs --trust, and --trust-config
# as well when it changes CI, test or dependency configuration. Its worktree
# never shares the main checkout's dependencies: unchanged ones are cloned from
# it (copy on write), changed ones installed from the PR's lock files.
# Exit 3 means a gate stopped the run before anything ran.
#
# Nothing here touches the dotorg sandbox.
#
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

SKILL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
	cat <<USAGE
Usage: wporg-test [--repo <name>] [<PR>|<branch>|<path>] [options]

  Target defaults to the current directory when it is a checkout of the repo.
  --repo defaults to the current directory's repo, then wordpress.org.

Options:
  --suite <key>   wordpress.org: run only this suite from .github/unit-tests-suites.yml (repeatable).
  --all           wordpress.org: run every suite, not just the ones the branch touches.
  --no-lint       wordpress.org: skip phpcs.
  --no-tests      wordpress.org: skip PHPUnit.
  --keep          Leave wp-env environments running afterwards.
  --list          Print what would run, then exit.
  --no-merge      Test the branch as it is instead of merged into the default branch.
  --trust         Someone else's PR: run its code. Read the diff first.
  --trust-config  Someone else's PR that changes CI, test, or dependency configuration: run that too.
USAGE
	exit "${1:-0}"
}

require git gh jq curl python3

{ read -r repo_name; mapfile -t args; } < <(repo_arg "$@")
set -- "${args[@]+"${args[@]}"}"
use_repo "$repo_name"

target=""; suites=(); all=""; lint=1; tests=1; keep=""; list_only=""; merge=1; trusted=""; trusted_config=""
while [[ $# -gt 0 ]]; do
	case $1 in
		--suite)        suites+=("$2"); shift ;;
		--all)          all=1 ;;
		--no-lint)      lint="" ;;
		--no-tests)     tests="" ;;
		--keep)         keep=1 ;;
		--list)         list_only=1 ;;
		--no-merge)     merge="" ;;
		--trust)        trusted=1 ;;
		--trust-config) trusted_config=1 ;;
		-h|--help)      usage ;;
		-*)             usage 1 ;;
		*)              target=$1 ;;
	esac
	shift
done
if [[ $WPORG_REPO_NAME != wordpress.org && ( ${#suites[@]} -gt 0 || -n $all || -z $lint || -z $tests ) ]]; then
	die "--suite, --all, --no-lint and --no-tests are for wordpress.org; $WPORG_REPO_NAME runs its profile's checks."
fi

# ── Resolve the worktree ────────────────────────────────────────────────────
pr=""; trust=""
if [[ -z $target ]]; then
	wt=$(git rev-parse --show-toplevel 2>/dev/null || true)
	[[ -n $wt && $(repo_of_dir "$wt") == "$WPORG_REPO_NAME" ]] || die "Not inside a $WPORG_REPO_NAME checkout; pass a PR, branch, or path."
elif [[ $target =~ ^[0-9]+$ ]]; then
	pr=$target
	IFS=$'\t' read -r _ wt _ _ trust <<< "$("$SKILL_DIR/bin/wporg-worktree" --repo "$WPORG_REPO_NAME" pr "$pr")"
elif [[ -d $target ]]; then
	wt=$(cd "$target" && git rev-parse --show-toplevel)
else
	wt=$("$SKILL_DIR/bin/wporg-worktree" --repo "$WPORG_REPO_NAME" path "$target")
	[[ -n $wt ]] || die "No worktree for branch $target. Create one: wporg-worktree --repo $WPORG_REPO_NAME new $target"
fi
wt=$(cd "$wt" && pwd -P)
[[ -n $trust ]] || trust=$(trust_of "$wt")
branch=$(git -C "$wt" branch --show-current)
log "Worktree: $wt ($branch, $([[ $trust == own ]] && echo yours || echo "someone else's"))"

git_retry -C "$wt" fetch -q origin "$WPORG_BRANCH"

# ── Gates for someone else's code ───────────────────────────────────────────
if [[ $trust != own && -z $list_only ]]; then
	if [[ -z $trusted ]]; then
		event test gated "$pr" "$branch: needs --trust"
		warn "$branch is someone else's PR; testing runs its code. Read the diff, then rerun with --trust."
		exit 3
	fi
	tooling=$(tooling_changes "$wt")
	if [[ -n $tooling && -z $trusted_config ]]; then
		event test gated "$pr" "$branch: needs --trust-config"
		warn "$branch changes configuration that installs and checks run: $(tr '\n' ' ' <<< "$tooling")Read those files, then rerun with --trust --trust-config."
		exit 3
	fi
fi

# Someone else's worktree gets its own copy of each dependency: a clone of the main checkout's when the manifest
# and lock match the default branch, else a fresh install from the PR's own.
own_deps() {
	local entry dir manifest lock cmd
	for entry in "${WPORG_LINKS[@]+"${WPORG_LINKS[@]}"}"; do
		[[ -e $wt/$entry ]] && continue
		dir=$(dirname "$entry")
		case $(basename "$entry") in
			vendor)       manifest=composer.json; lock=composer.lock; cmd="composer install --no-interaction --no-progress" ;;
			node_modules) manifest=package.json; lock=package-lock.json; cmd="npm ci --no-audit --no-fund" ;;
			*)            warn "No install rule for $entry; the checks that need it will fail."; continue ;;
		esac
		if [[ -d $WPORG_REPO/$entry ]] && git -C "$wt" diff --quiet "origin/$WPORG_BRANCH...HEAD" -- "$dir/$manifest" "$dir/$lock"; then
			log "Cloning $entry from the main checkout (copy on write)…"
			cp -cR "$WPORG_REPO/$entry" "$wt/$entry"
		else
			log "Installing $entry: $cmd (in ${dir})…"
			(cd "$wt/$dir" && $cmd < /dev/null) || { warn "Installing $entry failed."; rc=1; }
		fi
	done
}

rc=0
[[ $trust == own || -n $list_only ]] || own_deps

# ── Merge into the default branch, as CI does ───────────────────────────────
if [[ -n $merge ]]; then
	branch_head=$(git -C "$wt" rev-parse HEAD)
	mwt="$wt-merge"
	if [[ ! -d $mwt ]]; then
		git -C "$WPORG_REPO" worktree add -q --detach "$mwt" "origin/$WPORG_BRANCH"
	fi
	git -C "$mwt" merge --abort 2>/dev/null || true
	git -C "$mwt" checkout -q --detach "origin/$WPORG_BRANCH"
	# The merge checkout uses the worktree's dependencies: the main checkout's links for your PRs, its own copies otherwise.
	for entry in "${WPORG_LINKS[@]+"${WPORG_LINKS[@]}"}"; do
		if [[ -e $wt/$entry && -d $(dirname "$mwt/$entry") ]]; then ln -sfn "$wt/$entry" "$mwt/$entry"; fi
	done
	# A throwaway merge commit needs no signature; a missing gpg must not look like a conflict.
	if merge_out=$(git -C "$mwt" -c commit.gpgsign=false merge -q --no-ff --no-edit -m "Test merge of $branch" "$branch_head" 2>&1); then
		log "Testing $branch merged into origin/$WPORG_BRANCH at $mwt"
		wt=$mwt
	elif git -C "$mwt" merge-tree --write-tree "origin/$WPORG_BRANCH" "$branch_head" >/dev/null 2>&1; then
		git -C "$mwt" merge --abort 2>/dev/null || true
		warn "Could not create the test merge of $branch: $(grep -m1 -E '^(fatal|error):' <<< "$merge_out")"
		event test-merge failed "$pr" "merge commit failed"
		rc=1; merge=""
	else
		git -C "$mwt" merge --abort 2>/dev/null || true
		warn "$branch does not merge cleanly into origin/$WPORG_BRANCH; rebase it before CI can test it."
		event test-merge failed "$pr" "$branch conflicts"
		rc=1; merge=""
	fi
fi

changed=$(git -C "$wt" diff --name-only "origin/$WPORG_BRANCH...HEAD")
[[ -n $changed ]] || warn "No files differ from origin/$WPORG_BRANCH."

# Dedicated ports per worktree and suite keep test environments off the dev environments' 8888/8889.
pick_ports() {
	local seed port tests_port
	seed=$(( $(printf '%s' "$wt/$1" | cksum | cut -d' ' -f1) % 40 ))
	port=$(( 8900 + seed * 2 )); tests_port=$(( port + 1 ))
	while nc -z 127.0.0.1 "$port" 2>/dev/null || nc -z 127.0.0.1 "$tests_port" 2>/dev/null; do
		port=$(( port + 2 )); tests_port=$(( port + 1 ))
	done
	echo "$port $tests_port"
}

finish() {
	event test "$([[ $rc == 0 ]] && echo ok || echo failed)" "$pr" "$branch"
	if [[ $rc == 0 && ${skipped:-0} == 0 ]]; then ok "All checks passed for $branch."
	elif [[ $rc == 0 ]]; then warn "Checks passed for $branch, but $skipped suite(s) could not run on this branch."
	else warn "Checks failed for $branch; see above."; fi
	exit $rc
}

# ── Every repo but wordpress.org: the profile's checks ──────────────────────
if [[ $WPORG_REPO_NAME != wordpress.org ]]; then
	if [[ -n $list_only ]]; then
		jq -r --arg r "$WPORG_REPO_NAME" '.repos[$r].checks // [] | .[] | "\(.name)\t\(.run)"' "$(pipeline_file repos.json)"
		exit 0
	fi
	check=$(pipeline_file bin/check)
	event test start "$pr" "$branch"
	read -r port tests_port <<< "$(pick_ports "$WPORG_REPO_NAME")"
	log "Profile checks for $WPORG_REPO_NAME (wp-env ports $port/$tests_port)…"
	if WP_ENV_PORT=$port WP_ENV_TESTS_PORT=$tests_port "$check" "$WPORG_REPO_NAME" "$wt"; then
		event test-checks ok "$pr"
	else
		event test-checks failed "$pr"; rc=1
	fi
	if [[ -z $keep && -f $wt/.wp-env.json && -d $wt/node_modules ]]; then
		(cd "$wt" && WP_ENV_PORT=$port WP_ENV_TESTS_PORT=$tests_port npx wp-env stop >/dev/null 2>&1) || true
	fi
	finish
fi

# ── wordpress.org: phpcs and the suites CI selects ──────────────────────────
require php npm
checks_lib=$(pipeline_file bin/wordpress-org-checks.sh)
# shellcheck source=/dev/null
source "$checks_lib"

if [[ -n $list_only ]]; then
	wporg_select_suites "$wt" "$changed" "$all" "${suites[@]+"${suites[@]}"}" | awk -F'\x1f' '{printf "%-11s %-16s %s\n", $1, $2, $3}'
	exit 0
fi
event test start "$pr" "$branch"

if [[ -n $lint ]]; then
	log "phpcs on changed PHP files…"
	if wporg_phpcs "$wt"; then
		ok "phpcs clean"; event test-phpcs ok "$pr"
	else
		warn "phpcs reported violations"; event test-phpcs failed "$pr"; rc=1
	fi
fi

run_standalone() {
	local key=$1 name=$2 wd=$3 args=$4 bootstrap=$5 stub=""
	if [[ $bootstrap == "wpdb-stub" ]]; then
		stub=$(mktemp -t phpunit-bootstrap).php
		cat > "$stub" <<'PHP'
<?php
class wpdbStub {
	public function prepare( $query, ...$args ) { return $query; }
	public function get_results( $query, $output = 'OBJECT' ) { return []; }
}
PHP
		args=${args//\/tmp\/phpunit-bootstrap.php/$stub}
	fi
	local -a argv=()
	[[ -n $args ]] && read -ra argv <<< "$args"
	log "PHP: $name"
	if (cd "$wt/$wd" && "$wt/vendor/bin/phpunit" "${argv[@]+"${argv[@]}"}" < /dev/null); then
		ok "$name passed"; event test-suite ok "$pr" "$key"
	else
		warn "$name failed"; event test-suite failed "$pr" "$key"; rc=1
	fi
	if [[ -n $stub ]]; then rm -f "$stub"; fi
	return 0
}

started_envs=()
skipped=0
run_wordpress() {
	local key=$1 name=$2 script=$3 port tests_port
	if [[ ! -f $wt/environments/$key/.wp-env.test.json ]]; then
		warn "WP: $name skipped: environments/$key is not on this branch; CI runs it against the merge with trunk."
		event test-suite skipped "$pr" "$key"
		skipped=$(( skipped + 1 ))
		return 0
	fi
	local -a envvars=()
	read -r port tests_port <<< "$(pick_ports "$key")"
	envvars=(WP_ENV_PORT="$port" WP_ENV_TESTS_PORT="$tests_port")
	log "WP: $name (npm run $script, ports $port/$tests_port)"
	if (cd "$wt/environments" && env "${envvars[@]+"${envvars[@]}"}" npm run --silent "$script" < /dev/null); then
		ok "$name passed"; event test-suite ok "$pr" "$key"
	else
		warn "$name failed"; event test-suite failed "$pr" "$key"; rc=1
	fi
	started_envs+=("$key ${envvars[*]}")

	local code body
	body=$(mktemp -t wporg-smoke)
	code=$(curl -sS --max-time 30 -o "$body" -w '%{http_code}' "http://localhost:$port/" || echo 000)
	if [[ $code =~ ^(2|3)[0-9][0-9]$ ]] && ! grep -qE 'Fatal error|Parse error|Uncaught ' "$body"; then
		ok "smoke $code http://localhost:$port/"; event test-smoke ok "$pr" "$key"
	else
		warn "smoke $code http://localhost:$port/ $(grep -m1 -oE '(Fatal error|Parse error|Uncaught )[^<]{0,120}' "$body" || true)"
		event test-smoke failed "$pr" "$key"; rc=1
	fi
	rm -f "$body"
	return 0
}

stop_envs() {
	local entry key vars
	for entry in "${started_envs[@]+"${started_envs[@]}"}"; do
		key=${entry%% *}; vars=${entry#"$key"}
		# shellcheck disable=SC2086
		(cd "$wt/environments" && env $vars npx wp-env --config "$key/.wp-env.test.json" stop >/dev/null 2>&1) || true
	done
}

if [[ -n $tests ]]; then
	selected=$(wporg_select_suites "$wt" "$changed" "$all" "${suites[@]+"${suites[@]}"}")
	if [[ -z $selected ]]; then
		log "No test suite covers the changed files."
	else
		while IFS=$'\x1f' read -r type key name script wd args bootstrap; do
			case $type in
				standalone) run_standalone "$key" "$name" "$wd" "$args" "$bootstrap" ;;
				wordpress)  run_wordpress "$key" "$name" "$script" ;;
			esac
		done <<< "$selected"
		[[ -n $keep ]] || stop_envs
	fi
fi

finish
