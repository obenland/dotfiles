#!/bin/bash
# Restow every package after a successful merge (including git pull).
# Picks up new files added upstream without touching existing symlinks.
# Packages are auto-discovered: every non-hidden top-level directory.
set -e
cd "$(git rev-parse --show-toplevel)"
packages=(*/)
# claude-retro writes runtime data (reports, logs, worktrees) into ~/claude-retro; keep it a real dir so stow links its files instead of folding the whole dir into the repo.
mkdir -p "$HOME/claude-retro"
stow -R "${packages[@]%/}" || echo "stow failed; fix the conflicts above and run: stow -d ~/dotfiles -R ${packages[*]%/}"

# Install or refresh the nightly claude-retro schedule (re-renders the LaunchAgent plist or crontab entry).
if [ -x "$HOME/claude-retro/install.sh" ]; then
    "$HOME/claude-retro/install.sh" >/dev/null || echo "claude-retro: install.sh failed"
fi

# Sync Claude Code plugins from settings.json's enabledPlugins.
# Installs any enabled plugin that isn't already installed. Idempotent.
# Silently skipped if claude or jq is unavailable (e.g. fresh machine before Homebrew bootstrap).
if command -v claude >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
    settings="$HOME/.claude/settings.json"
    if [ -f "$settings" ]; then
        # Register settings.json's extraKnownMarketplaces first, so plugins from them can install.
        known=$(claude plugin marketplace list --json 2>/dev/null | jq -r '.[].name' || true)
        while IFS=$'\t' read -r name source; do
            [ -z "$name" ] && continue
            if ! grep -qxF "$name" <<<"$known"; then
                echo "Adding Claude plugin marketplace: $name"
                claude plugin marketplace add "$source" || echo "  failed"
            fi
        done < <(jq -r '(.extraKnownMarketplaces // {}) | to_entries[] | [.key, (.value.source | .repo // .url // .path)] | @tsv' "$settings")
        enabled=$(jq -r '(.enabledPlugins // {}) | to_entries[] | select(.value == true) | .key' "$settings")
        installed=$(claude plugin list --json 2>/dev/null | jq -r '.[].id' || true)
        while IFS= read -r plugin; do
            [ -z "$plugin" ] && continue
            if ! grep -qxF "$plugin" <<<"$installed"; then
                echo "Installing Claude plugin: $plugin"
                claude plugin install "$plugin" || echo "  failed (is the marketplace registered?)"
            fi
        done <<<"$enabled"
    fi
fi
