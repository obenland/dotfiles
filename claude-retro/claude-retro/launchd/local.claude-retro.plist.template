<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.claude-retro</string>

	<!-- A dedicated launcher (built by install.sh) so Full Disk Access can be granted to this job alone, not to /bin/bash. -->
	<key>ProgramArguments</key>
	<array>
		<string>@HOME@/Library/Application Support/claude-retro/claude-retro-launcher</string>
	</array>

	<key>WorkingDirectory</key>
	<string>@HOME@/claude-retro</string>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>@HOME@/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>HOME</key>
		<string>@HOME@</string>
		<key>USER</key>
		<string>@USER@</string>
	</dict>

	<!-- Nightly at the time in config/schedule; launchd fires a missed one on wake. -->
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>@HOUR@</integer>
		<key>Minute</key>
		<integer>@MINUTE@</integer>
	</dict>

	<!-- run.sh exits non-zero when a run failed or is waiting for a full wake or the network; launchd then
	     starts it again 30 minutes later, until a run exits 0. This also runs it once at load (login, or
	     install.sh after a pull); run.sh exits 0 at once unless last night's run is still unfinished. -->
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>1800</integer>

	<key>StandardOutPath</key>
	<string>@HOME@/claude-retro/logs/retro.out.log</string>
	<key>StandardErrorPath</key>
	<string>@HOME@/claude-retro/logs/retro.err.log</string>

	<key>ProcessType</key>
	<string>Background</string>
</dict>
</plist>
