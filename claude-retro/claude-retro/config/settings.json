{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(~/.claude/**)",
      "Read(~/dotfiles/**)",
      "Edit(~/claude-retro/reports/**)",
      "Edit(~/claude-retro/work/**)"
    ],
    "deny": [
      "Bash",
      "WebFetch",
      "WebSearch",
      "Agent",
      "Edit(~/claude-retro/.claude/**)",
      "Edit(~/claude-retro/config/**)",
      "Edit(~/claude-retro/bin/**)",
      "Edit(~/claude-retro/launchd/**)",
      "Edit(~/claude-retro/run.sh)",
      "Edit(~/claude-retro/prompt.md)",
      "Edit(~/claude-retro/worktrees/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.docker/config.json)",
      "Read(~/.config/gh/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.claude.json)",
      "Read(~/.zsh_history)",
      "Read(~/.bash_history)"
    ]
  },
  "disableAllHooks": true
}
