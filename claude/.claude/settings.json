{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(brew *)",
      "Bash(claude *)",
      "Bash(composer dump-autoload *)",
      "Bash(composer install *)",
      "Bash(composer list *)",
      "Bash(composer show *)",
      "Bash(composer update *)",
      "Bash(docker compose *)",
      "Bash(docker info *)",
      "Bash(docker system *)",
      "Bash(du *)",
      "Bash(echo *)",
      "Bash(find *)",
      "Bash(gh api *)",
      "Bash(gh issue view *)",
      "Bash(gh label *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh repo *)",
      "Bash(gh run view *)",
      "Bash(git -C * add *)",
      "Bash(git -C * blame *)",
      "Bash(git -C * branch *)",
      "Bash(git -C * check-ignore *)",
      "Bash(git -C * checkout *)",
      "Bash(git -C * cherry-pick *)",
      "Bash(git -C * commit *)",
      "Bash(git -C * config *)",
      "Bash(git -C * diff *)",
      "Bash(git -C * fetch *)",
      "Bash(git -C * log *)",
      "Bash(git -C * ls-tree *)",
      "Bash(git -C * mv *)",
      "Bash(git -C * pull *)",
      "Bash(git -C * push *)",
      "Bash(git -C * rebase *)",
      "Bash(git -C * status *)",
      "Bash(git -C * worktree *)",
      "Bash(git add *)",
      "Bash(git blame *)",
      "Bash(git branch *)",
      "Bash(git check-ignore *)",
      "Bash(git checkout *)",
      "Bash(git cherry-pick *)",
      "Bash(git commit *)",
      "Bash(git config *)",
      "Bash(git diff *)",
      "Bash(git fetch *)",
      "Bash(git log *)",
      "Bash(git ls-tree *)",
      "Bash(git mv *)",
      "Bash(git pull *)",
      "Bash(git push *)",
      "Bash(git rebase *)",
      "Bash(git status *)",
      "Bash(git worktree *)",
      "Bash(grep *)",
      "Bash(jetpack *)",
      "Bash(jp *)",
      "Bash(ls *)",
      "Bash(mkdir -p *)",
      "Bash(npm install *)",
      "Bash(npm run lint*)",
      "Bash(npm run start*)",
      "Bash(npm run test:js*)",
      "Bash(npm test)",
      "Bash(npx tsc *)",
      "Bash(phpcs *)",
      "Bash(tmux *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Read",
      "WebFetch(domain:developer.chrome.com)",
      "WebFetch(domain:developer.wordpress.org)",
      "WebFetch(domain:make.wordpress.org)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebSearch",
      "mcp__chrome-devtools",
      "mcp__context-a8c"
    ],
    "deny": [
      "Read(*~/.ssh/**)",
      "Read(*~/.aws/**)",
      "Read(*~/.gnupg/**)",
      "Read(*~/.netrc)",
      "Read(*~/.npmrc)",
      "Read(*~/.docker/config.json)",
      "Read(*~/.zsh_history)",
      "Read(*~/.bash_history)",
      "Read(*~/Library/**)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(svn ci *)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/pre-commit-review.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/svn-guard.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/notify.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "basename \"$PWD\"",
    "padding": 0
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "unit-tests@automattic-claude-code-plugins": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    }
  },
  "effortLevel": "high",
  "autoDreamEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "skipAutoPermissionPrompt": true,
  "additionalDirectories": [
    "/tmp"
  ],
  "teammateMode": "tmux",
  "defaultMode": "bypassPermissions",
  "skills": {
    "allowedSkills": [
      "commit",
      "sup",
      "wrap",
      "review",
      "team",
      "learn"
    ]
  }
}
