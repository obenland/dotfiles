#!/usr/bin/env bash
#
# wporg-worktree — create, list and remove sibling worktrees of a profiled repo's checkout (default: wordpress.org).
#
# Worktrees live next to the main checkout as <repo>-<branch-slug>, the
# layout already in use. Each new worktree gets the profile's dependency
# links (for wordpress.org, vendor/ and environments/node_modules) from the
# main checkout, so phpcs and wp-env work there without a second install.
#
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

usage() {
	cat <<USAGE
Usage: wporg-worktree new <branch> [<start-point>]   Create ../<repo>-<slug> on <branch> (default start: origin/<default branch>).
       wporg-worktree pr <PR>                         Print "<branch>\t<path>\t<remote>\t<head ref>\t<own|other>" for a PR, creating its worktree if needed.
       wporg-worktree rm <branch|path> [--force]     Remove the worktree; delete the branch when its PR is closed.
       wporg-worktree ls                              List worktrees with dirty-file counts and PR state.
       wporg-worktree prune [--dry-run]               Remove worktrees whose PR is merged or closed, unless dirty, ahead of the PR, or mounted by a running container.
       wporg-worktree path <branch>                   Print the worktree path for a branch.

Every command takes --repo <name>: a repo profiled in \$WPORG_PIPELINE_DIR/repos.json, checked out at
\$WPORG_CODE_DIR/<name>. Default: the current directory's repo, then wordpress.org.
USAGE
	exit "${1:-0}"
}

require git gh jq

{ read -r repo_name; mapfile -t args; } < <(repo_arg "$@")
set -- "${args[@]+"${args[@]}"}"
use_repo "$repo_name"
parent=$(dirname "$WPORG_REPO")
base=$(basename "$WPORG_REPO")

slug_for() { echo "${1//\//-}"; }

path_for_branch() {
	git -C "$WPORG_REPO" worktree list --porcelain | awk -v b="refs/heads/$1" '
		/^worktree /{p=substr($0,10)} /^branch /{if ($2==b) print p}'
}

# The dependency links are ours, not the branch's; a trailing-slash ignore pattern does not match a symlink.
dirty_entries() {
	git -C "$1" status --porcelain | untracked_links
}

pr_state() {
	if [[ $1 =~ ^pr-([0-9]+)$ ]]; then
		gh pr view "${BASH_REMATCH[1]}" --repo "$WPORG_GH_REPO" --json number,state \
			--jq '"\(.state|ascii_downcase) #\(.number)"' 2>/dev/null || echo "unknown"
		return
	fi
	gh pr list --repo "$WPORG_GH_REPO" --head "$1" --state all --limit 1 --json number,state \
		--jq 'if length==0 then "no-pr" else "\(.[0].state|ascii_downcase) #\(.[0].number)" end' 2>/dev/null || echo "unknown"
}

link_deps() {
	# Exclude the links in the shared info/exclude so `git add -A` can't commit them.
	local exclude entry
	exclude="$(git -C "$WPORG_REPO" rev-parse --path-format=absolute --git-common-dir)/info/exclude"
	for entry in "${WPORG_LINKS[@]+"${WPORG_LINKS[@]}"}"; do
		grep -qxF "/$entry" "$exclude" 2>/dev/null || echo "/$entry" >> "$exclude"
		if [[ -d $WPORG_REPO/$entry && ! -e $1/$entry && -d $(dirname "$1/$entry") ]]; then ln -s "$WPORG_REPO/$entry" "$1/$entry"; fi
	done
}

lower() { tr '[:upper:]' '[:lower:]' <<< "$1"; }

# remote_for <owner> <repo> — the remote for github.com/<owner>/<repo>, added under the owner's name when there is none.
remote_for() {
	local want name url
	want=$(lower "$1/$2")
	while read -r name url _; do
		[[ $(lower "$url") =~ github\.com[:/]([^/]+/[^/]+)$ && ${BASH_REMATCH[1]%.git} == "$want" ]] && { echo "$name"; return; }
	done < <(git -C "$WPORG_REPO" remote -v | grep ' (push)$')
	name=$(lower "$1")
	git -C "$WPORG_REPO" remote get-url "$name" >/dev/null 2>&1 && die "Remote $name exists but does not point at $1/$2."
	git -C "$WPORG_REPO" remote add "$name" "git@github.com:$1/$2.git"
	echo "$name"
}

cmd_new() {
	local branch=${1:-} start=${2:-origin/$WPORG_BRANCH}
	[[ -n $branch ]] || usage 1
	local path="$parent/$base-$(slug_for "$branch")"
	[[ -e $path ]] && die "$path already exists."
	local existing
	existing=$(path_for_branch "$branch")
	[[ -n $existing ]] && die "Branch $branch is already checked out at $existing."

	git_retry -C "$WPORG_REPO" fetch -q origin "$WPORG_BRANCH"
	if git -C "$WPORG_REPO" show-ref -q --verify "refs/heads/$branch"; then
		git -C "$WPORG_REPO" worktree add -q "$path" "$branch"
	elif git_retry -C "$WPORG_REPO" fetch -q "$WPORG_PUSH_REMOTE" "$branch" 2>/dev/null; then
		git -C "$WPORG_REPO" worktree add -q --track -b "$branch" "$path" "$WPORG_PUSH_REMOTE/$branch"
	else
		git -C "$WPORG_REPO" worktree add -q -b "$branch" "$path" "$start"
	fi

	# PR heads live on the push remote (the fork for wordpress.org); make a bare `git push` go there.
	git -C "$path" config "branch.$branch.remote" "$WPORG_PUSH_REMOTE"
	git -C "$path" config "branch.$branch.merge" "refs/heads/$branch"
	git -C "$path" config push.autoSetupRemote true
	[[ -n ${SKIP_LINKS:-} ]] || link_deps "$path"

	event worktree created "" "$branch"
	echo "$path"
}

# A PR whose branch is on the repo's push remote (your fork for wordpress.org, origin elsewhere) is worked on under its
# own branch name. Anyone else's is checked out as pr-<N> at its head, since their branch name (patch-1, trunk) says
# nothing about which local branch holds it.
# The last field says whether the PR is yours: its branch is on your fork, or on origin with you as the author. Code from
# anyone else's PR never gets the main checkout's dependency links, since its install scripts could write through them.
cmd_pr() {
	local pr=${1:-}
	[[ $pr =~ ^[0-9]+$ ]] || usage 1
	local json ref oid owner repo author me branch remote path trust=other
	json=$(gh pr view "$pr" --repo "$WPORG_GH_REPO" --json headRefName,headRefOid,headRepository,headRepositoryOwner,author)
	ref=$(jq -r .headRefName <<< "$json"); oid=$(jq -r .headRefOid <<< "$json")
	owner=$(jq -r '.headRepositoryOwner.login // empty' <<< "$json"); repo=$(jq -r '.headRepository.name // empty' <<< "$json")
	author=$(jq -r '.author.login // empty' <<< "$json")
	[[ $ref =~ ^[A-Za-z0-9._/-]+$ && $oid =~ ^[0-9a-f]{40}$ ]] || die "Unexpected head for PR #$pr."
	[[ $owner =~ ^[A-Za-z0-9-]+$ && $repo =~ ^[A-Za-z0-9._-]+$ ]] || die "PR #$pr's head repository no longer exists."

	remote=$(remote_for "$owner" "$repo")
	me=$(gh api user --jq .login)
	if [[ $remote == fork && $(lower "$owner") == "$(lower "$me")" ]] || [[ $remote == origin && $(lower "$owner") == wordpress && $author == "$me" ]]; then
		trust=own
	fi
	if [[ $remote == "$WPORG_PUSH_REMOTE" && ( $trust == own || $remote == origin ) ]]; then
		branch=$ref
		path=$(path_for_branch "$branch")
		[[ -n $path ]] || path=$(SKIP_LINKS=$([[ $trust == own ]] || echo 1) cmd_new "$branch")
	else
		branch=pr-$pr
		path=$(path_for_branch "$branch")
		if [[ -z $path ]]; then
			path="$parent/$base-$branch"
			[[ -e $path ]] && die "$path already exists."
			git_retry -C "$WPORG_REPO" fetch -q "$remote" "$ref"
			if git -C "$WPORG_REPO" show-ref -q --verify "refs/heads/$branch"; then
				git -C "$WPORG_REPO" worktree add -q "$path" "$branch"
			else
				git -C "$WPORG_REPO" worktree add -q -b "$branch" "$path" "$oid"
			fi
			git -C "$path" config "branch.$branch.remote" "$remote"
			git -C "$path" config "branch.$branch.merge" "refs/heads/$ref"
			[[ $trust == own ]] && link_deps "$path"
			event worktree created "$pr" "$branch"
		fi
	fi
	# wporg-test and the review sessions read this back when they are given only the worktree.
	git -C "$WPORG_REPO" config "branch.$branch.wporgTrust" "$trust"
	# A worktree from before this rule may still carry the links; they are ours to remove.
	if [[ $trust != own ]]; then
		local entry
		for entry in "${WPORG_LINKS[@]+"${WPORG_LINKS[@]}"}"; do
			if [[ -L $path/$entry && $(readlink "$path/$entry") == "$WPORG_REPO/$entry" ]]; then rm -f "$path/$entry"; fi
		done
	fi
	printf '%s\t%s\t%s\t%s\t%s\n' "$branch" "$path" "$remote" "$ref" "$trust"
}

cmd_rm() {
	local target=${1:-} force=${2:-}
	[[ -n $target ]] || usage 1
	local path branch
	if [[ -d $target ]]; then
		path=$(cd "$target" && pwd -P)
	else
		path=$(path_for_branch "$target")
		[[ -n $path ]] || die "No worktree for branch $target."
	fi
	[[ $path != "$(cd "$WPORG_REPO" && pwd -P)" ]] || die "Refusing to remove the main checkout."
	branch=$(git -C "$path" branch --show-current)

	if [[ -n $(dirty_entries "$path") && $force != "--force" ]]; then
		die "$path has uncommitted changes. Pass --force to discard them."
	fi
	local entry
	for entry in "${WPORG_LINKS[@]+"${WPORG_LINKS[@]}"}"; do
		if [[ -L $path/$entry ]]; then rm -f "$path/$entry"; fi
		if [[ -L $path-merge/$entry ]]; then rm -f "$path-merge/$entry"; fi
	done
	# Drop the worktree's wp-env instances while their mounted paths still resolve.
	"$(dirname "${BASH_SOURCE[0]}")/wp-env-prune" --quiet --path "$path" || warn "wp-env-prune failed for $path."
	if [[ -d $path-merge ]]; then
		"$(dirname "${BASH_SOURCE[0]}")/wp-env-prune" --quiet --path "$path-merge" || warn "wp-env-prune failed for $path-merge."
	fi
	git -C "$WPORG_REPO" worktree remove ${force:+--force} "$path"
	# wporg-test keeps a detached <path>-merge sibling for testing the branch merged into the default branch.
	if [[ -d $path-merge ]]; then
		git -C "$WPORG_REPO" worktree remove --force "$path-merge"
	fi

	local state
	state=$(pr_state "$branch")
	case $state in
		closed*|merged*)
			git -C "$WPORG_REPO" branch -D "$branch" >/dev/null && log "Deleted branch $branch ($state)." ;;
		*)
			log "Kept branch $branch ($state)." ;;
	esac
	event worktree removed "" "$branch"
	ok "Removed $path"
}

cmd_ls() {
	git -C "$WPORG_REPO" worktree list --porcelain | awk '/^worktree /{p=substr($0,10)} /^branch /{print p "\t" substr($2,12)}' |
	while IFS=$'\t' read -r path branch; do
		[[ $path == "$WPORG_REPO" ]] && continue
		local dirty
		dirty=$(dirty_entries "$path" | wc -l | tr -d ' ')
		printf '%-55s %-45s dirty=%-3s %s\n' "$path" "$branch" "$dirty" "$(pr_state "$branch")"
	done
}

# pr_info <branch> — "<state> <number> <head sha>" of the branch's PR (or of PR <N> for a pr-<N> branch); empty when there is none.
pr_info() {
	if [[ $1 =~ ^pr-([0-9]+)$ ]]; then
		gh pr view "${BASH_REMATCH[1]}" --repo "$WPORG_GH_REPO" --json number,state,headRefOid \
			--jq '"\(.state|ascii_downcase) \(.number) \(.headRefOid)"' 2>/dev/null || true
		return
	fi
	gh pr list --repo "$WPORG_GH_REPO" --head "$1" --state all --limit 1 --json number,state,headRefOid \
		--jq '.[0] | select(.) | "\(.state|ascii_downcase) \(.number) \(.headRefOid)"' 2>/dev/null || true
}

# Remove every worktree whose PR is merged or closed, as long as nothing local would be lost.
cmd_prune() {
	local dry=${1:-} mounts path branch state number head local_head removed=0 kept=0
	[[ -z $dry || $dry == --dry-run ]] || usage 1
	mounts=$(docker ps -q 2>/dev/null | xargs docker inspect --format '{{range .Mounts}}{{.Source}}{{"\n"}}{{end}}' 2>/dev/null || true)
	while IFS=$'\t' read -r path branch; do
		[[ $path == "$WPORG_REPO" ]] && continue
		state="" number="" head=""
		read -r state number head <<< "$(pr_info "$branch")"
		[[ $state == merged || $state == closed ]] || continue
		if [[ -n $(dirty_entries "$path") ]]; then
			warn "Kept $path: uncommitted changes (#$number $state)."; kept=$((kept + 1)); continue
		fi
		# The PR head stays on GitHub as refs/pull/<N>/head, so only commits beyond it would be lost.
		local_head=$(git -C "$path" rev-parse HEAD)
		# A worktree behind the PR has never fetched its head; fetch it before testing ancestry.
		if [[ $local_head != "$head" ]] && ! git -C "$path" cat-file -e "$head^{commit}" 2>/dev/null; then
			git -C "$path" fetch -q origin "refs/pull/$number/head" 2>/dev/null || true
		fi
		if [[ $local_head != "$head" ]] && ! { git -C "$path" cat-file -e "$head^{commit}" 2>/dev/null && git -C "$path" merge-base --is-ancestor "$local_head" "$head"; }; then
			warn "Kept $path: local commits not in #$number."; kept=$((kept + 1)); continue
		fi
		if grep -qE "^($path|$path-merge)(/|$)" <<< "$mounts"; then
			warn "Kept $path: a running container mounts it."; kept=$((kept + 1)); continue
		fi
		removed=$((removed + 1))
		if [[ -n $dry ]]; then
			log "Would remove $path (#$number $state)."
			continue
		fi
		"${BASH_SOURCE[0]}" --repo "$WPORG_REPO_NAME" rm "$path" || { warn "Failed to remove $path."; removed=$((removed - 1)); }
	done < <(git -C "$WPORG_REPO" worktree list --porcelain | awk '/^worktree /{p=substr($0,10)} /^branch /{print p "\t" substr($2,12)}')
	ok "$WPORG_REPO_NAME: $([[ -n $dry ]] && echo "would remove" || echo removed) $removed worktrees; kept $kept with a closed PR."
}

case ${1:-} in
	new)  shift; cmd_new "$@" ;;
	rm)   shift; cmd_rm "$@" ;;
	ls)   cmd_ls ;;
	prune) shift; cmd_prune "$@" ;;
	pr)   shift; cmd_pr "$@" ;;
	path) [[ -n ${2:-} ]] || usage 1; path_for_branch "$2" ;;
	-h|--help|"") usage ;;
	*) usage 1 ;;
esac
