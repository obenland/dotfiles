#!/bin/bash
# Restow every package after a successful merge (including git pull).
# Picks up new files added upstream without touching existing symlinks.
# Packages are auto-discovered: every non-hidden top-level directory.
set -e
cd "$(git rev-parse --show-toplevel)"
packages=(*/)
stow -R "${packages[@]%/}"

# Sync Claude Code plugins from settings.json's enabledPlugins.
# Installs any enabled plugin that isn't already installed. Idempotent.
# Silently skipped if claude or jq is unavailable (e.g. fresh machine before Homebrew bootstrap).
if command -v claude >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
    settings="$HOME/.claude/settings.json"
    if [ -f "$settings" ]; then
        enabled=$(jq -r '(.enabledPlugins // {}) | to_entries[] | select(.value == true) | .key' "$settings")
        installed=$(claude plugin list --json 2>/dev/null | jq -r '.[].id' || true)
        while IFS= read -r plugin; do
            [ -z "$plugin" ] && continue
            if ! grep -qxF "$plugin" <<<"$installed"; then
                echo "Installing Claude plugin: $plugin"
                claude plugin install "$plugin" || echo "  failed (is the marketplace registered?)"
            fi
        done <<<"$enabled"
    fi
fi
